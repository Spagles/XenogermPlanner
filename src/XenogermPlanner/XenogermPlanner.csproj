<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <RootNamespace>XenogermPlanner</RootNamespace>
        <AssemblyName>XenogermPlanner</AssemblyName>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <EscarvalRimWorldUiProjectDir>$(MSBuildThisFileDirectory)..\..\..\Escarval.RimWorld.UI\src\Escarval.RimWorld.UI</EscarvalRimWorldUiProjectDir>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="XenogermPlanner.Tests"/>
    </ItemGroup>

    <Import Project="..\XenogermPlanner.Local.props" Condition="Exists('..\XenogermPlanner.Local.props')"/>

    <Target Name="ValidateLocalConfiguration" BeforeTargets="ResolveReferences">
        <Error Condition="'$(RimWorldManagedDir)' == ''" Text="RimWorldManagedDir is not configured. Create src\XenogermPlanner.Local.props from docs\XenogermPlanner.Local.props.example and set the path to RimWorld's Managed directory."/>
        <Error Condition="'$(RimWorldManagedDir)' != '' and !Exists('$(RimWorldManagedDir)\Assembly-CSharp.dll')" Text="Assembly-CSharp.dll was not found in '$(RimWorldManagedDir)'. Update RimWorldManagedDir in src\XenogermPlanner.Local.props."/>
    </Target>

    <Target Name="ValidateSharedUiProject" BeforeTargets="PrepareForBuild">
        <Error Condition="!Exists('$(EscarvalRimWorldUiProjectDir)\Escarval.RimWorld.UI.csproj')" Text="Escarval.RimWorld.UI project was not found at '$(EscarvalRimWorldUiProjectDir)'. Keep Escarval.RimWorld.UI and XenogermPlanner as sibling directories under the same RimWorldMods directory."/>
        <Error Condition="!Exists('$(EscarvalRimWorldUiProjectDir)\Source')" Text="Escarval.RimWorld.UI source directory was not found at '$(EscarvalRimWorldUiProjectDir)\Source'. Verify the external shared UI project structure."/>
    </Target>

    <ItemGroup>
        <ProjectReference Include="$(EscarvalRimWorldUiProjectDir)\Escarval.RimWorld.UI.csproj" ReferenceOutputAssembly="false"/>

        <Compile Include="$(EscarvalRimWorldUiProjectDir)\Source\**\*.cs"
                 Link="SharedUI\%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup Condition="'$(RimWorldManagedDir)' != ''">
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="UnityEngine" Condition="Exists('$(RimWorldManagedDir)\UnityEngine.dll')">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="UnityEngine.CoreModule" Condition="Exists('$(RimWorldManagedDir)\UnityEngine.CoreModule.dll')">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="UnityEngine.TextRenderingModule" Condition="Exists('$(RimWorldManagedDir)\UnityEngine.TextRenderingModule.dll')">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="UnityEngine.IMGUIModule" Condition="Exists('$(RimWorldManagedDir)\UnityEngine.IMGUIModule.dll')">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <Target Name="CopyAssemblyToMod" AfterTargets="Build">
        <MakeDir Directories="$(RimWorldModAssembliesDir)"/>

        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(RimWorldModAssembliesDir)" SkipUnchangedFiles="true"/>
    </Target>
</Project>